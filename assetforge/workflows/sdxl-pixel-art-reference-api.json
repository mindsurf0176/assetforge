{
  "3": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["5", 0],
      "seed": "${SEED}",
      "steps": "${STEPS}",
      "cfg": "${CFG}",
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["11", 0],
      "denoise": "${DENOISE}"
    }
  },
  "4": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "${CHECKPOINT}"
    }
  },
  "5": {
    "class_type": "LoraLoader",
    "inputs": {
      "model": ["4", 0],
      "clip": ["4", 1],
      "lora_name": "${LORA}",
      "strength_model": "${LORA_STRENGTH_MODEL}",
      "strength_clip": "${LORA_STRENGTH_CLIP}"
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "${PROMPT}",
      "clip": ["5", 1]
    }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "${NEGATIVE_PROMPT}",
      "clip": ["5", 1]
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["3", 0],
      "vae": ["4", 2]
    }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "assetforge/sdxl-reference-pixel",
      "images": ["13", 0]
    }
  },
  "10": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "${REFERENCE_IMAGE}"
    }
  },
  "11": {
    "class_type": "VAEEncode",
    "inputs": {
      "pixels": ["12", 0],
      "vae": ["4", 2]
    }
  },
  "12": {
    "class_type": "ImageScale",
    "inputs": {
      "image": ["10", 0],
      "upscale_method": "nearest-exact",
      "width": "${WIDTH}",
      "height": "${HEIGHT}",
      "crop": "disabled"
    }
  },
  "13": {
    "class_type": "ImageScale",
    "inputs": {
      "image": ["8", 0],
      "upscale_method": "nearest-exact",
      "width": "${PIXEL_WIDTH}",
      "height": "${PIXEL_HEIGHT}",
      "crop": "disabled"
    }
  }
}
