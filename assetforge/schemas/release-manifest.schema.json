{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:assetforge:release-manifest:schema:1",
  "title": "AssetForge portable sprite release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "assetforgeVersion",
    "character",
    "direction",
    "profile",
    "tier",
    "source",
    "clips",
    "files",
    "releaseFingerprint"
  ],
  "properties": {
    "$schema": {"const": "urn:assetforge:release-manifest:schema:1"},
    "schemaVersion": {"const": 1},
    "kind": {"const": "sprite-release"},
    "assetforgeVersion": {"type": "string", "minLength": 1},
    "character": {"$ref": "#/$defs/id"},
    "direction": {"$ref": "#/$defs/id"},
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "file", "sha256", "fingerprint"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "file": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"},
        "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{16}$"}
      }
    },
    "tier": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout", "clipCount"],
      "properties": {
        "layout": {"const": "clip-directories-or-flat"},
        "clipCount": {"type": "integer", "minimum": 1}
      }
    },
    "clips": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fps", "loop", "frameCount", "frames", "validation"],
        "properties": {
          "fps": {"type": "number", "exclusiveMinimum": 0},
          "loop": {"type": "boolean"},
          "frameCount": {"type": "integer", "minimum": 1},
          "frames": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
          "validation": {"type": "object"}
        }
      }
    },
    "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
    "releaseFingerprint": {"type": "string", "pattern": "^[a-f0-9]{16}$"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
